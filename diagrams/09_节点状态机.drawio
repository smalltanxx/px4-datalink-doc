<mxfile host="app.diagrams.net"><diagram name="09_节点状态机" id="p9"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;ROS 2 节点状态机：从等 FMU 到圆周&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1600" height="34" as="geometry"/></mxCell><mxCell id="s" value="ax_circular_flight 的八个状态；PreStream 预热 1 s，WaitArmed / WaitOffboard 每 0.5 s 重发，无超时/无看门狗" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555" vertex="1" parent="1"><mxGeometry x="0" y="48" width="1600" height="22" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;WaitForFmu&lt;/b&gt;&lt;br&gt;等 fmu_out 首帧" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;PreStream&lt;/b&gt;&lt;br&gt;预热 1 s 再发 ARM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="228" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;WaitArmed&lt;/b&gt;&lt;br&gt;0.5 s 重发 ARM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="426" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;WaitOffboard&lt;/b&gt;&lt;br&gt;0.5 s 重发 DO_SET_MODE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="624" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;Takeoff&lt;/b&gt;&lt;br&gt;爬到 -altitude_m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="822" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;Transit&lt;/b&gt;&lt;br&gt;推到圆周起点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;Circle&lt;/b&gt;&lt;br&gt;50 Hz 圆周设定点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1218" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;Done&lt;/b&gt;&lt;br&gt;仅 hold&amp;gt;0 可达" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1416" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t1" value="发布节奏：每周期先发 OffboardControlMode（timerCallback :173）；trajectory_setpoint 只在 Takeoff/Transit/Circle/Done 里发，50 Hz" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="1500" height="30" as="geometry"/></mxCell><mxCell id="t2" value="失败路径：三个等待态无超时、无重试上限；没有看门狗；收到过一帧后不再校验时间戳" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="30" y="285" width="1500" height="30" as="geometry"/></mxCell><mxCell id="t3" value="关键常量：kOffboardRateHz=50；altitude_m=1、radius_m=10、speed=10 → 周期 2πr/v ≈ 6.28 s" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="1500" height="30" as="geometry"/></mxCell><mxCell id="t4" value="Done 不可达：hold_after_complete_s 默认 0，节点永远停在 Circle（无限绕圈）" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="30" y="375" width="1500" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
