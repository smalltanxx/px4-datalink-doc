<mxfile host="app.diagrams.net"><diagram name="11_失效保护时序" id="p11"><mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1340" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;失效保护：一帧之内的执行时序&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=34;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="1100" height="52" as="geometry"/></mxCell><mxCell id="s" value="自上而下是 Failsafe::update() 的调用顺序；黄色是两处计时器更新" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=#555555" vertex="1" parent="1"><mxGeometry x="0" y="72" width="1100" height="32" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b&gt;Failsafe::update()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14" vertex="1" parent="1"><mxGeometry x="40" y="150" width="620" height="96" as="geometry"/></mxCell><mxCell id="n0" value="每 10 ms 一拍；下面是 8 个步骤的真实顺序" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#333333" vertex="1" parent="1"><mxGeometry x="690" y="150" width="370" height="96" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;1 清理 + defer 超时&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14" vertex="1" parent="1"><mxGeometry x="40" y="280" width="620" height="96" as="geometry"/></mxCell><mxCell id="n1" value="解锁/上锁、模式变化 → removeActions()；defer 超时 → 关闭" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#333333" vertex="1" parent="1"><mxGeometry x="690" y="280" width="370" height="96" as="geometry"/></mxCell><mxCell id="e1" value=