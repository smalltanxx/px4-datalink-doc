ddle;spacingLeft=14;spacingRight=14" vertex="1" parent="1"><mxGeometry x="40" y="670" width="620" height="96" as="geometry"/></mxCell><mxCell id="n4" value="Offboard / RC 丢失的模式回退，也入同一队列" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#333333" vertex="1" parent="1"><mxGeometry x="690" y="670" width="370" height="96" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#EF6C00" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5 清理失效条目 + clearDelayIfNeeded()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14" vertex="1" parent="1"><mxGeometry x="40" y="800" width="620" height="96" as="geometry"/></mxCell><mxCell id="n5" value="已在 failsafe / Hold 不可运行 / 已接管 → 清零" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#333333" vertex="1" parent="1"><mxGeometry x="690" y="800" width="370" height="96" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#EF6C00" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6 getSelectedAction() 七阶段&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14" vertex="1" parent="1"><mxGeometry x="40" y="930" width="620" height="96" as="geometry"/></mxCell><mxCell id="n6" value="①Terminate/armed ②聚合 ③defer ④Hold ⑤接管 ⑥回退 ⑦UX" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#333333" vertex="1" parent="1"><mxGeometry x="690" y="930" width="370" height="96" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#EF6C00" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;7 updateStartDelay()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="620" height="96" as="geometry"/></mxCell><mxCell id="n7" value="有 delayed_action 则按 dt 递减，否则按 dt/4 回涨" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#333333" vertex="1" parent="1"><mxGeometry x="690" y="1060" width="370" height="96" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#EF6C00" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;8 defer 状态 + 通知 + 提交&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14" vertex="1" parent="1"><mxGeometry x="40" y="1190" width="620" height="96" as="geometry"/></mxCell><mxCell id="n8" value="updateFailsafeDeferState()；通知；提交 _selected_action" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#333333" vertex="1" parent="1"><mxGeometry x="690" y="1190" width="370" height="96" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#EF6C00" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>