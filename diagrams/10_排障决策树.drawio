<mxfile host="app.diagrams.net"><diagram name="10_排障决策树" id="p"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1280" math="0" shadow="0"><root><mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="t" value="&lt;b&gt;排障决策梯：Offboard 链路逐级定位（飞机不动 / 不响应）&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fillColor=none;strokeColor=none;rounded=1;spacingLeft=8;spacingRight=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1600" height="34" as="geometry"/></mxCell>
<mxCell id="s" value="按数据流方向自上游往下游查；每级先回答“是/否”，“否”对应的红框就是该级要修的东西" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=none;strokeColor=none;rounded=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="0" y="48" width="1600" height="22" as="geometry"/></mxCell>
<mxCell id="top" value="&lt;b&gt;飞机不动 / Offboard 无响应&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#FFF8E1;strokeColor=#F57F17;rounded=1;spacingLeft=8;spacingRight=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="620" y="70" width="360" height="34" as="geometry"/></mxCell>
<mxCell id="q0" value="&lt;b&gt;PX4 主进程在跑？&lt;br&gt;commander status 有输出？&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#BBDEFB;strokeColor=#1565C0;rounded=1;spacingLeft=8;spacingRight=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="130" width="460" height="62" as="geometry"/></mxCell>
<mxCell id="c0" value="进程崩了或被 kill：看 PX4 控制台尾部、ps 里有没有 bin/px4；SITL 还要看 gz sim 是否活着（没有 gz 会卡在 Waiting for Gazebo world）" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#FFCDD2;strokeColor=#C62828;rounded=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="560" y="130" width="1000" height="62" as="geometry"/></mxCell>
<mxCell id="e_top" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="104" as="sourcePoint"/><mxPoint x="270.0" y="130" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="n0" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="161" as="sourcePoint"/><mxPoint x="560" y="161" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="q1" value="&lt;b&gt;uXRCE-DDS 通了吗？&lt;br&gt;MicroXRCEAgent 在跑、8888 端口一致？&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#BBDEFB;strokeColor=#1565C0;rounded=1;spacingLeft=8;spacingRight=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="230" width="460" height="62" as="geometry"/></mxCell>
<mxCell id="c1" value="Agent 没起 / 端口或 domain 不一致：uxrce_dds_client status、ss -lunp | grep 8888、ROS_DOMAIN_ID 与 UXRCE_DDS_DOM_ID 对照" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#FFCDD2;strokeColor=#C62828;rounded=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="560" y="230" width="1000" height="62" as="geometry"/></mxCell>
<mxCell id="e1" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="192" as="sourcePoint"/><mxPoint x="270.0" y="230" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="n1" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="261" as="sourcePoint"/><mxPoint x="560" y="261" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="q2" value="&lt;b&gt;ROS 2 收到 /fmu/out/* 了吗？&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#BBDEFB;strokeColor=#1565C0;rounded=1;spacingLeft=8;spacingRight=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="330" width="460" height="62" as="geometry"/></mxCell>
<mxCell id="c2" value="话题没出来：ros2 topic list 看后缀（_v1/_v4 随版本变化）、QoS 是否 best_effort、节点是否 source 了同一个 domain" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#FFCDD2;strokeColor=#C62828;rounded=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="560" y="330" width="1000" height="62" as="geometry"/></mxCell>
<mxCell id="e2" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="292" as="sourcePoint"/><mxPoint x="270.0" y="330" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="n2" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="361" as="sourcePoint"/><mxPoint x="560" y="361" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="q3" value="&lt;b&gt;vehicle_local_position 的&lt;br&gt;xy_valid / z_valid 为真？&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#BBDEFB;strokeColor=#1565C0;rounded=1;spacingLeft=8;spacingRight=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="430" width="460" height="62" as="geometry"/></mxCell>
<mxCell id="c3" value="GPS/EKF 未就绪：fix_type、satellites_used、eph/epv、EKF2_GPS_CTRL、EKF2_REQ_GPS_H；listener estimator_status" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#FFCDD2;strokeColor=#C62828;rounded=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="560" y="430" width="1000" height="62" as="geometry"/></mxCell>
<mxCell id="e3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="392" as="sourcePoint"/><mxPoint x="270.0" y="430" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="n3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="461" as="sourcePoint"/><mxPoint x="560" y="461" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="q4" value="&lt;b&gt;offboard_control_mode&lt;br&gt;在按周期发？&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#BBDEFB;strokeColor=#1565C0;rounded=1;spacingLeft=8;spacingRight=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="530" width="460" height="62" as="geometry"/></mxCell>
<mxCell id="c4" value="节点崩溃/定时器阻塞/终端被 Ctrl-C：超过 COM_OF_LOSS_T（1 s）后 offboard_control_signal_lost 置位，进 §8.7 的 fallback（本次 RTL）" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#FFCDD2;strokeColor=#C62828;rounded=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="560" y="530" width="1000" height="62" as="geometry"/></mxCell>
<mxCell id="e4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="492" as="sourcePoint"/><mxPoint x="270.0" y="530" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="n4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="561" as="sourcePoint"/><mxPoint x="560" y="561" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="q5" value="&lt;b&gt;trajectory_setpoint&lt;br&gt;也在发、数值合理？&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#BBDEFB;strokeColor=#1565C0;rounded=1;spacingLeft=8;spacingRight=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="630" width="460" height="62" as="geometry"/></mxCell>
<mxCell id="c5" value="只发 control_mode 不发设定点是常见错误：位置/速度全 0 或 NaN 会让飞机原地不动。分别看 /fmu/in/trajectory_setpoint 的频率、z 与速度分量" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#FFCDD2;strokeColor=#C62828;rounded=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="560" y="630" width="1000" height="62" as="geometry"/></mxCell>
<mxCell id="e5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="592" as="sourcePoint"/><mxPoint x="270.0" y="630" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="n5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="661" as="sourcePoint"/><mxPoint x="560" y="661" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="q6" value="&lt;b&gt;nav_state 与 nav_state_user_intention 一致？&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#BBDEFB;strokeColor=#1565C0;rounded=1;spacingLeft=8;spacingRight=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="730" width="460" height="62" as="geometry"/></mxCell>
<mxCell id="c6" value="不一致要分开看：命令被拒（vehicle_command_ack、commander check、preflight）与飞行中 failsafe 接管（failsafe_flags、§8.7）是两回事" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#FFCDD2;strokeColor=#C62828;rounded=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="560" y="730" width="1000" height="62" as="geometry"/></mxCell>
<mxCell id="e6" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="692" as="sourcePoint"/><mxPoint x="270.0" y="730" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="n6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="761" as="sourcePoint"/><mxPoint x="560" y="761" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="q7" value="&lt;b&gt;actuator_motors 有输出？&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#BBDEFB;strokeColor=#1565C0;rounded=1;spacingLeft=8;spacingRight=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="830" width="460" height="62" as="geometry"/></mxCell>
<mxCell id="c7" value="控制分配/混控：control_allocator status、CA_AIRFRAME 与 CA_ROTOR* 是否和 SDF 几何一致、MPC_THR_HOVER" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#FFCDD2;strokeColor=#C62828;rounded=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="560" y="830" width="1000" height="62" as="geometry"/></mxCell>
<mxCell id="e7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="792" as="sourcePoint"/><mxPoint x="270.0" y="830" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="n7" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="861" as="sourcePoint"/><mxPoint x="560" y="861" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="q8" value="&lt;b&gt;Gazebo 收到电机指令？&lt;br&gt;转速在 MIN..MAX 区间？&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#BBDEFB;strokeColor=#1565C0;rounded=1;spacingLeft=8;spacingRight=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="930" width="460" height="62" as="geometry"/></mxCell>
<mxCell id="c8" value="桥接段：GZMixingInterfaceESC、gz topic -e /world/default/model/netdrone_0/link/rotor_0/...、SIM_GZ_EC_MIN/MAX 与 SIM_GZ_EC_FUNC 通道映射" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#FFCDD2;strokeColor=#C62828;rounded=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="560" y="930" width="1000" height="62" as="geometry"/></mxCell>
<mxCell id="e8" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="892" as="sourcePoint"/><mxPoint x="270.0" y="930" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="n8" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="961" as="sourcePoint"/><mxPoint x="560" y="961" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="q9" value="&lt;b&gt;有输出但不起飞 / 侧翻？&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#BBDEFB;strokeColor=#1565C0;rounded=1;spacingLeft=8;spacingRight=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="460" height="62" as="geometry"/></mxCell>
<mxCell id="c9" value="几何、转向、推力系数：CA_ROTOR*_PX/PY/KM 与 SDF 的 pose、turningDirection、motorConstant 逐项对照；桨效与 THR_MDL_FAC" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#FFCDD2;strokeColor=#C62828;rounded=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="560" y="1030" width="1000" height="62" as="geometry"/></mxCell>
<mxCell id="e9" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="992" as="sourcePoint"/><mxPoint x="270.0" y="1030" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="n9" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="1061" as="sourcePoint"/><mxPoint x="560" y="1061" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="end" value="&lt;b&gt;全部为“是”仍不动 → 回查控制分配与机体模型：control_allocator 配置、SDF 电机参数、CA_ROTOR_COUNT 与翼型&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#C8E6C9;strokeColor=#2E7D32;rounded=1;spacingLeft=8;spacingRight=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="1520" height="46" as="geometry"/></mxCell>
<mxCell id="e_end" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="1092" as="sourcePoint"/><mxPoint x="270.0" y="1130" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="note" value="&lt;b&gt;补充：QGC / MAVLink 是独立的监控与地面操作链，不是 Offboard 的必要条件。&lt;/b&gt;&lt;br&gt;它看不到姿态，不代表 ROS 2 → PX4 的控制链有故障；它能看到姿态，也不能证明设定点正常。&lt;br&gt;排查 QGC 本身走另一条路：18570（GCS）/14550、mavlink status、mavlink stream -l。" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#FFF8E1;strokeColor=#F57F17;rounded=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="1520" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
