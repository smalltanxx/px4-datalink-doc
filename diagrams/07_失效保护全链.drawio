<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="07_失效保护全链" id="p"><mxGraphModel dx="1600" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="&lt;b&gt;失效保护全链：检测 → 决策 → 动作&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1600" height="34" as="geometry"/></mxCell>
<mxCell id="s" value="同一轮 Failsafe::update() 内的三段；蓝色=模块/函数，黄色=uORB 或队列，绿色=最终动作，红色=会改变结果的分支" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555" vertex="1" parent="1"><mxGeometry x="0" y="48" width="1600" height="22" as="geometry"/></mxCell>
<mxCell id="c1" value="检测（HealthAndArmingChecks/checks）" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="400" height="20" as="geometry"/></mxCell>
<mxCell id="c2" value="决策（failsafe.cpp）" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="470" y="80" width="640" height="20" as="geometry"/></mxCell>
<mxCell id="c3" value="动作（framework.cpp: getSelectedAction）" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="1140" y="80" width="430" height="20" as="geometry"/></mxCell>
<mxCell id="d1" value="各 check 只写 flag，不选动作&lt;br&gt;offboardCheck：控制位 + 新鲜度 + 估计有效性&lt;br&gt;rcAndDataLinkCheck：manual / gcs 超时&lt;br&gt;gnssRedundancyCheck：数量/散度 + block_arming&lt;br&gt;batteryCheck：warning / unhealthy / 剩余时间&lt;br&gt;estimatorCheck：位置误差、低精度&lt;br&gt;modeCheck：mode_req_* 可用性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="400" height="190" as="geometry"/></mxCell>
<mxCell id="d2" value="failsafe_flags（uORB）&lt;br&gt;offboard_control_signal_lost / manual_control_signal_lost&lt;br&gt;gcs_connection_lost / gnss_lost / battery_warning&lt;br&gt;local_position_invalid / position_accuracy_low …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="400" height="110" as="geometry"/></mxCell>
<mxCell id="d3" value="解锁前独立机制：HealthAndArmingChecks&lt;br&gt;以 NavModes::All 报告失败 → 直接阻止解锁&lt;br&gt;不进入右侧 action 队列" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="d4" value="跨轮次状态&lt;br&gt;_selected_action：上一轮最终动作（Terminate 保持用）&lt;br&gt;_current_delay：Auto 首次入队置位（含 None）&lt;br&gt;defer 期间暂停；clearDelayIfNeeded 清零&lt;br&gt;_current_start_delay：扣到 0 后按 dt/4 回涨" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#4E342E;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="m1" value="checkStateAndMode()　548-713&lt;br&gt;RC / GCS → fromNavDllOrRclActParam()&lt;br&gt;mission_failure / mission_control_lost（AUTO_MISSION）&lt;br&gt;gnss / geofence / wind / flight-time / parachute / ODID / fd_*&lt;br&gt;battery 三入口（warning 受解锁等级门控）&lt;br&gt;navigator_failure → Land（TAKEOFF/RTL）或 Hold（含 OFFBOARD）&lt;br&gt;最后：mode-fallback 入队（Always + cannotBeDeferred）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="110" width="640" height="210" as="geometry"/></mxCell>
<mxCell id="m2" value="checkModeFallback()　730-771&lt;br&gt;① Offboard 丢失 → COM_OBL_RC_ACT；若为 Disarm 立即 return&lt;br&gt;② POSCTL/POSITION_SLOW → ALTCTL → STAB&lt;br&gt;③ manual lost → NAV_RCL_ACT 替换（只改 action，不改意图模式）&lt;br&gt;④ 末次 modeCanRun(当前意图模式) → 无条件 RTL（可覆盖 ③ 的 Disarm/Terminate）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="350" width="640" height="150" as="geometry"/></mxCell>
<mxCell id="m3" value="_actions[8]：每 caller 一条；None 占槽位不参与聚合；槽满替换最后一个更低槽，否则不入队（不初始化延迟）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="530" width="640" height="70" as="geometry"/></mxCell>
<mxCell id="m4" value="两个容易混的点&lt;br&gt;• cannotBeDeferred() 只影响 defer，不阻止计时器启动&lt;br&gt;• Always 只是 takeover 权限；全局 _current_delay&amp;gt;0 时同样被改成 Hold&lt;br&gt;• None 会启动计时器，但自己不产生 Hold，延迟在后台被消耗" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="640" height="90" as="geometry"/></mxCell>
<mxCell id="a1" value="① Terminate 保持 → armed 门控&lt;br&gt;先 Terminate，再判 armed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="110" width="350" height="60" as="geometry"/></mxCell>
<mxCell id="a2" value="② 严重度聚合&lt;br&gt;None&amp;lt;Warn&amp;lt;Fallback*&amp;lt;Hold&amp;lt;RTL&amp;lt;Land&amp;lt;Descend&amp;lt;Disarm&amp;lt;Terminate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="182" width="350" height="60" as="geometry"/></mxCell>
<mxCell id="a3" value="③ defer&lt;br&gt;所有参与聚合动作可 defer 才暂挂；开始后 updateDelay 暂停" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="254" width="350" height="60" as="geometry"/></mxCell>
<mxCell id="a4" value="④ Hold 延迟&lt;br&gt;_current_delay&amp;gt;0 且未接管且 takeover≤AlwaysModeSwitchOnly 且动作可延迟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="326" width="350" height="60" as="geometry"/></mxCell>
<mxCell id="a5" value="⑤ 用户接管&lt;br&gt;仅 Hold/RTL/Land/Descend → Warn，清 delayed_action；再跑 checkModeFallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="398" width="350" height="60" as="geometry"/></mxCell>
<mxCell id="a6" value="⑥ modeCanRun 回退&lt;br&gt;起点=选中动作：Fallback*→Hold→RTL→Land→Descend→Terminate；Disarm 独立" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="470" width="350" height="60" as="geometry"/></mxCell>
<mxCell id="a7" value="⑦ UX 降级&lt;br&gt;已在 LAND/RTL/PRECLAND：RTL（或 Land）→Warn，清 delayed_action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="542" width="350" height="60" as="geometry"/></mxCell>
<mxCell id="a8" value="最终 action → 模式切换 / 通知 / 记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="614" width="350" height="40" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="flags" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="d2" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="m3" target="a1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1165" y="565"/><mxPoint x="1165" y="140"/></Array></mxGeometry></mxCell>
