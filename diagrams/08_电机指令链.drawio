<mxfile host="app.diagrams.net"><diagram name="08_电机指令链" id="p"><mxGraphModel dx="1600" dy="470" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="&lt;b&gt;电机指令链：control_allocator → Gazebo 转速&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1600" height="34" as="geometry"/></mxCell>
<mxCell id="s" value="从归一化电机指令到仿真转速；黄色为 uORB topic，绿色为仿真侧" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555" vertex="1" parent="1"><mxGeometry x="0" y="48" width="1600" height="22" as="geometry"/></mxCell>
<mxCell id="m1" value="control_allocator&lt;br&gt;CA_AIRFRAME=0（Multirotor）&lt;br&gt;→ actuator_motors[0..3] ∈[0,1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="m2" value="FunctionMotors&lt;br&gt;THR_MDL_FAC 反解&lt;br&gt;非可逆 [0,1]→[-1,1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="m3" value="MixingOutput&lt;br&gt;SIM_GZ_EC_MIN/MAX 缩放&lt;br&gt;（本次 190 / 1466）&lt;br&gt;armed / lockdown·kill / termination&lt;br&gt;ramp_up=false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="110" width="270" height="110" as="geometry"/></mxCell>
<mxCell id="m4" value="GZMixingInterfaceESC&lt;br&gt;gz.msgs.Actuators.velocity&lt;br&gt;/netdrone_0/command/motor_speed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="270" height="110" as="geometry"/></mxCell>
<mxCell id="m5" value="Gazebo MulticopterMotorModel&lt;br&gt;motorConstant / momentConstant&lt;br&gt;转速 → 推力 / 反扭矩" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="110" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="t2" value="actuator_outputs（QGC SERVO_OUTPUT_RAW 来源）&lt;br&gt;缩放后的转速指令；不是 PWM 微秒，也不是 Gazebo 实测转速" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="520" height="50" as="geometry"/></mxCell>
<mxCell id="t3" value="esc_status：同一 gz topic 的自订阅回读&lt;br&gt;= PX4 自己发出的命令，不是独立测量" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="920" y="300" width="420" height="50" as="geometry"/></mxCell>
<mxCell id="t4" value="为什么没有 500 ms 爬升：构造 MixingOutput 时传 ramp_up=false，&lt;br&gt;状态机 OFF→ON 直接生效；PWMSim/UAVCAN/Cyphal/Vertiq 同为 false" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#4E342E;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="760" height="50" as="geometry"/></mxCell>
