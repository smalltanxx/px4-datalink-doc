        <mxCell id="p04-note" value="代码索引：mavlink_main.cpp:1090-1175（init_udp）、:900-945（send_finish/UDP sendto）、:2401（-f forwarding）；&#10;mavlink_receiver.cpp:3740-3825（recvfrom/源地址学习）、:494（COMMAND_LONG）、:1061（SET_MODE）、:1177（SET_POSITION_TARGET_LOCAL_NED）、:2231（RC override）、:2318（MANUAL_CONTROL）、:2903（GPS_RTCM_DATA）。&#10;QGC 默认监听 14550；PX4 GCS 链路绑定 18570。若 PX4 收不到 QGC，先查 QGC 的 UDP 链路目标端口和本机防火墙。" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#4E342E;fillColor=#EFEBE9;strokeColor=#A1887F;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="30" y="930" width="1480" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="05 ROS 2 / uXRCE-DDS 链路" id="p05">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p05-title" value="ROS 2 / uXRCE-DDS 链路：话题、版本后缀、QoS 与 Offboard 指令路径" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="15" width="840" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p05-sub" value="PX4 是 XRCE-DDS Client，MicroXRCEAgent 是 Agent；ROS 2 节点只看到 /fmu/out 与 /fmu/in 话题" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="350" y="55" width="900" height="22" as="geometry" />
        </mxCell>

        <mxCell id="p05-outband" value="① PX4 → ROS 2：/fmu/out（PX4 发布，ROS 订阅）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontStyle=1;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="1530" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p05-cmd" value="commander&#10;vehicle_status (v4)&#10;vehicle_command_ack (v1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p05-ekf" value="EKF2&#10;vehicle_local_position (v1)&#10;vehicle_global_position" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="40" y="225" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p05-gps" value="VehicleGPSPosition&lt;br&gt;vehicle_gps_position（SensorGps）&lt;br&gt;/fmu/out/vehicle_gps_position（无版本后缀）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="40" y="315" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p05-uxr" value="uxrce_dds_client&#10;UDP 8888 → Agent&#10;&#10;SendTopicsSubs::update()&#10;uORB → ucdr 序列化&#10;best-effort + transient-local" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="370" y="160" width="250" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-agt" value="MicroXRCEAgent&#10;udp4 -p 8888&#10;XRCE ↔ DDS 桥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="690" y="190" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p05-rosout" value="ROS 2 节点&#10;ax_circular_flight&#10;&#10;订阅：&#10;/fmu/out/vehicle_status_v4&#10;/fmu/out/vehicle_local_position_v1&#10;（BEST_EFFORT）&#10;&#10;versionedTopic&lt;MsgT&gt;()&#10;按 MESSAGE_VERSION 拼后缀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=10;align=left;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="990" y="130" width="560" height="210" as="geometry" />
        </mxCell>

        <mxCell id="p05-inband" value="② ROS 2 → PX4：/fmu/in（ROS 发布，PX4 订阅）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontStyle=1;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="30" y="430" width="1530" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p05-rosin" value="ROS 2 节点发布&#10;&#10;/fmu/in/offboard_control_mode&#10;/fmu/in/trajectory_setpoint&#10;/fmu/in/vehicle_command&#10;&#10;50 Hz 定时器；先持续发 setpoint&#10;再 arm → OFFBOARD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=10;align=left;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="990" y="475" width="560" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p05-agt2" value="MicroXRCEAgent&#10;DDS → XRCE&#10;反序列化后下发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="690" y="535" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p05-uxr2" value="RcvTopicsPubs&#10;on_topic_update()&#10;ucdr_deserialize&#10;→ uORB publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="370" y="515" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p05-orb" value="uORB&#10;vehicle_command&#10;offboard_control_mode&#10;trajectory_setpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="40" y="515" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p05-cmd2" value="commander&#10;handle_command / offboard 检查&#10;vehicle_control_mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p05-mc" value="mc_pos_control&#10;消费 trajectory_setpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p05-vers" value="版本后缀规则（src/modules/uxrce_dds_client/utilities.hpp:27-42）&#10;MESSAGE_VERSION != 0 → 话题名追加 _vN&#10;VehicleStatus=4 → _v4；VehicleLocalPosition=1 → _v1&#10;OffboardControlMode / TrajectorySetpoint / VehicleCommand=0 → 不加后缀" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#4A148C;fillColor=#F3E5F5;strokeColor=#CE93D8;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="690" y="690" width="860" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p05-qos" value="QoS：PX4 发布端 TRANSIENT_LOCAL + BEST_EFFORT；ROS 订阅必须 BEST_EFFORT，否则收不到。&#10;PX4 接收端 VOLATILE + BEST_EFFORT；ROS 发布用默认 RELIABLE 也可兼容。&#10;时间：UXRCE_DDS_SYNCT=1，uXRCE 用 Agent 时间偏移修正消息 timestamp；UXRCE_DDS_SYNCC=0 不改系统时钟。" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#1B5E20;fillColor=#F1F8E9;strokeColor=#AED581;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="690" y="780" width="860" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p05-note" value="节点关键代码：ax_circular_flight.cpp:63-72 versionedTopic；:114-135 订阅/发布；:163-196 状态机；:371-399 offboard 与命令。&#10;启动：MicroXRCEAgent udp4 -p 8888；ros2 run ax_circular_flight ax_circular_flight。" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#0D47A1;fillColor=#E3F2FD;strokeColor=#90CAF9;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="620" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p05-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00" edge="1" parent="1" source="p05-cmd" target="p05-uxr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p05-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00" edge="1" parent="1" source="p05-ekf" target="p05-uxr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p05-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00" edge="1" parent="1" source="p05-gps" target="p05-uxr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p05-e4" value="UDP 8888" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9" edge="1" parent="1" source="p05-uxr" target="p05-agt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p05-e5" value="DDS/RTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9" edge="1" parent="1" source="p05-agt" target="p05-rosout">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p05-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32" edge="1" parent="1" source="p05-rosin" target="p05-agt2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p05-e7" value="UDP 8888" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontSize=9" edge="1" parent="1" source="p05-agt2" target="p05-uxr2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p05-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32" edge="1" parent="1" source="p05-uxr2" target="p05-orb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p05-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32" edge="1" parent="1" source="p05-orb" target="p05-cmd2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p05-e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32" edge="1" parent="1" source="p05-orb" target="p05-mc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="560" />
              <mxPoint x="330" y="770" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="06 Offboard 控制闭环" id="p06">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p06-title" value="Offboard 控制闭环：从 trajectory_setpoint 到 Gazebo 电机转速" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="15" width="840" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p06-sub" value="本次圆周飞行实际经过的控制器与执行器链；每一级都通过 uORB 解耦" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="420" y="55" width="760" height="22" as="geometry" />
        </mxCell>

        <mxCell id="p06-sp" value="trajectory_setpoint&#10;position / velocity / acceleration / yaw（NED）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="95" width="560" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p06-pos" value="mc_pos_control&#10;MulticopterPositionControl::Run()&#10;PositionControl::update() → 姿态设定点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="185" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p06-attsp" value="vehicle_attitude_setpoint&#10;q_d + thrust_body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="290" width="560" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p06-att" value="mc_att_control&#10;姿态误差 → 角速率设定点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="380" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p06-ratesp" value="vehicle_rates_setpoint&#10;roll/pitch/yaw rate + thrust" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="485" width="560" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p06-rate" value="mc_rate_control&#10;角速率 PID → torque；油门 → thrust" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="575" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p06-thr" value="vehicle_thrust_setpoint + vehicle_torque_setpoint&#10;归一化推力/力矩（FRD）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="680" width="560" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p06-alloc" value="control_allocator&#10;CA_AIRFRAME=0（四旋翼 X）→ actuator_motors[0..3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="770" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p06-mot" value="actuator_motors&#10;control[0..3] ∈ [0,1]（NaN=未使用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="870" width="560" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p06-func" value="FunctionMotors&#10;SIM_GZ_EC_FUNC1=101 …&#10;归一化 → SIM_GZ_EC_MIN/MAX&#10;（190…1466）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1140" y="850" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p06-gz" value="GZMixingInterfaceESC&#10;gz.msgs.Actuators.velocity&#10;发布 /netdrone_0/command/motor_speed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1140" y="960" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p06-gz2" value="Gazebo&#10;MulticopterMotorModel ×4&#10;motorConstant / momentConstant&#10;→ 桨叶推力/反扭矩&#10;→ ODE 刚体动力学" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1420" y="870" width="150" height="170" as="geometry" />
        </mxCell>

        <mxCell id="p06-gate" value="vehicle_control_mode 是门控条件：&#10;flag_control_offboard_enabled + position/velocity/attitude/rates 对应位&#10;由 commander 在 updateControlMode() 中按 nav_state 生成。" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#1B5E20;fillColor=#E8F5E9;strokeColor=#A5D6A7;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p06-note1" value="mc_pos_control：:435 取 setpoint；:461 OFFBOARD 分支&#10;:603 发 local_pos_sp；:609 发 attitude_sp&#10;mc_att_control：:369 发 rates_sp&#10;mc_rate_control：:260 发 thrust；:264 发 torque" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#0D47A1;fillColor=#E3F2FD;strokeColor=#90CAF9;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="80" y="95" width="400" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p06-note2" value="control_allocator：:378 取 torque；:390 取 thrust&#10;:716 组装 actuator_motors；:744 发布&#10;FunctionMotors：:52 订阅 actuator_motors；:65 更新&#10;GZMixingInterfaceESC：:65 输出；:79 组装；:90 发布" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#0D47A1;fillColor=#E3F2FD;strokeColor=#90CAF9;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="80" y="720" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p06-note3" value="CA_ROTOR0..3_PX/PY 定义电机位置；KM 定义反扭矩符号&#10;SIM_GZ_EC_FUNC1..4=101..104 → Motor1..4&#10;SIM_GZ_EC_MIN=190 / MAX=1466 对齐 SDF maxRotVelocity&#10;MPC_THR_HOVER=0.32" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#1B5E20;fillColor=#F1F8E9;strokeColor=#AED581;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="80" y="890" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p06-feedback" value="物理反馈：Gazebo 的 IMU/NavSat/Mag 又通过 gz_bridge 写回 uORB，进入 EKF2，形成闭环（见 02/03 页）" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#4E342E;fillColor=#EFEBE9;strokeColor=#A1887F;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="80" y="1030" width="900" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p06-e1" value="NED 位置/速度/加速度" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9" edge="1" parent="1" source="p06-sp" target="p06-pos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p06-e2" value="姿态四元数 + 推力" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9" edge="1" parent="1" source="p06-pos" target="p06-attsp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p06-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00" edge="1" parent="1" source="p06-attsp" target="p06-att">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p06-e4" value="角速率 + 推力" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9" edge="1" parent="1" source="p06-att" target="p06-ratesp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p06-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00" edge="1" parent="1" source="p06-ratesp" target="p06-rate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p06-e6" value="推力/力矩" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF6C00;fontSize=9" edge="1" parent="1" source="p06-rate" target="p06-thr">
