  <diagram name="03 遥控/手动控制链路" id="p03">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p03-title" value="遥控 / 手动控制链路：RC、QGC 摇杆、RC override 如何汇入 manual_control_setpoint" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="15" width="1100" height="40" as="geometry" /></mxCell><mxCell id="p03-sub" value="COM_RC_IN_MODE=1（以 param show 为准）：真实 RC 不参与选源；QGC 摇杆经 MANUAL_CONTROL 生效；QGC RC override 进入 input_rc 但被 selector 拒绝" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#5A6670;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="58" width="1300" height="40" as="geometry" /></mxCell><mxCell id="p03-rx" value="RC 接收机&lt;br&gt;SBUS / CRSF / DSM / PPM&lt;br&gt;/dev/ttyS* 或 PPM 引脚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;strokeWidth=1.5;dashed=1;fontSize=12;align=center;fontColor=#616161;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="190" height="70" as="geometry" /></mxCell><mxCell id="p03-rcin" value="rc_input 驱动&lt;br&gt;协议扫描/解析&lt;br&gt;发布 input_rc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;strokeWidth=1.5;dashed=1;fontSize=12;align=center;fontColor=#616161;" vertex="1" parent="1"><mxGeometry x="270" y="180" width="190" height="70" as="geometry" /></mxCell><mxCell id="p03-inrc" value="input_rc&lt;br&gt;18 通道原始值&lt;br&gt;RSSI / failsafe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="180" width="180" height="90" as="geometry" /></mxCell><mxCell id="p03-rcup" value="rc_update&lt;br&gt;校准/映射/开关解码&lt;br&gt;发布 manual_control_input&lt;br&gt;+ manual_control_switches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="730" y="180" width="220" height="90" as="geometry" /></mxCell><mxCell id="p03-rcch" value="rc_channels&lt;br&gt;（校准后通道值）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="200" height="50" as="geometry" /></mxCell><mxCell id="p03-mavrc" value="MAVLink RC_CHANNELS&lt;br&gt;→ QGC 显示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="100" width="280" height="50" as="geometry" /></mxCell><mxCell id="p03-mcin-rc" value="manual_control_input&lt;br&gt;data_source = SOURCE_RC&lt;br&gt;（override / 真机 RC；已发布）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="230" height="65" as="geometry" /></mxCell><mxCell id="p03-sw" value="manual_control_switches&lt;br&gt;mode_slot / arm_switch&lt;br&gt;（旁路输出，本次不参与选源）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="395" width="230" height="65" as="geometry" /></mxCell><mxCell id="p03-qgc-ovr" value="QGC RC override&lt;br&gt;MAVLink RC_CHANNELS_OVERRIDE&lt;br&gt;chan1..18_raw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="220" height="70" as="geometry" /></mxCell><mxCell id="p03-qgc-stick" value="QGC 摇杆&lt;br&gt;MAVLink MANUAL_CONTROL&lt;br&gt;x/y/z/r ∈ [-1000,1000]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="220" height="70" as="geometry" /></mxCell><mxCell id="p03-mcin-mav" value="manual_control_input&lt;br&gt;data_source = SOURCE_MAVLINK_0&lt;br&gt;（QGC 摇杆）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="780" y="500" width="220" height="65" as="geometry" /></mxCell><mxCell id="p03-sel" value="ManualControl / ManualControlSelector&lt;br&gt;COM_RC_IN_MODE=1 → 只选 MAVLINK_0&lt;br&gt;超时 COM_RC_LOSS_T=0.5s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1080" y="360" width="310" height="160" as="geometry" /></mxCell><mxCell id="p03-sp" value="manual_control_setpoint&lt;br&gt;roll/pitch/yaw/throttle&lt;br&gt;sticks_moving / buttons / data_source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1080" y="580" width="310" height="85" as="geometry" /></mxCell><mxCell id="p03-cmd" value="commander&lt;br&gt;摇杆解锁/上锁手势&lt;br&gt;模式开关 / action_request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="730" width="270" height="70" as="geometry" /></mxCell><mxCell id="p03-mc" value="mc_pos_control / mc_att_control&lt;br&gt;手动位置/姿态控制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1080" y="730" width="310" height="70" as="geometry" /></mxCell><mxCell id="p03-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#9E9E9E;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p03-rx" target="p03-rcin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p03-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#9E9E9E;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p03-rcin" target="p03-inrc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p03-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03-qgc-ovr" target="p03-inrc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="385" /><mxPoint x="590" y="270" /></Array></mxGeometry></mxCell><mxCell id="p03-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03-inrc" target="p03-rcup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p03-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03-rcup" target="p03-mcin-rc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p03-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03-rcup" target="p03-rcch"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p03-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03-rcch" target="p03-mavrc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p03-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03-rcup" target="p03-sw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="225" /><mxPoint x="700" y="427" /><mxPoint x="760" y="427" /></Array></mxGeometry></mxCell><mxCell id="p03-e9" value="被拒绝" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;strokeColor=#EF6C00;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p03-mcin-rc" target="p03-sel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1035" y="332" /><mxPoint x="1035" y="400" /><mxPoint x="1080" y="400" /></Array></mxGeometry></mxCell><mxCell id="p03-e10" value="被选中" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03-mcin-mav" target="p03-sel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="532" /><mxPoint x="1050" y="480" /><mxPoint x="1080" y="480" /></Array></mxGeometry></mxCell><mxCell id="p03-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03-qgc-stick" target="p03-mcin-mav"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="555" /><mxPoint x="500" y="532" /><mxPoint x="780" y="532" /></Array></mxGeometry></mxCell><mxCell id="p03-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03-sel" target="p03-sp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p03-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03-sp" target="p03-cmd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="622" /><mxPoint x="860" y="730" /></Array></mxGeometry></mxCell><mxCell id="p03-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#EF6C00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03-sp" target="p03-mc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p03-legend-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CFD8DC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="835" width="1520" height="125" as="geometry" /></mxCell><mxCell id="p03-legend" value="&lt;b&gt;图例&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#EF6C00&quot;&gt;橙色实线&lt;/b&gt;：本次 SITL 实际发生的数据流（发布 / 订阅 / 调用）&lt;br&gt;&lt;b style=&quot;color:#EF6C00&quot;&gt;橙色虚线&lt;/b&gt;：代码路径存在，但本次 SITL 不生效（硬件未接入，或被 selector 拒绝）&lt;br&gt;&lt;span style=&quot;color:#616161&quot;&gt;灰色虚线框&lt;/span&gt;：真实硬件支路，SITL 未接入" style="text;html=1;align=left;verticalAlign=top;fontSize=11.5;fontColor=#37474F;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="55" y="843" width="720" height="110" as="geometry" /></mxCell><mxCell id="p03-key" value="&lt;b&gt;关键点&lt;/b&gt;&lt;br&gt;COM_RC_IN_MODE=1 → selector 只接受 &lt;b&gt;SOURCE_MAVLINK_0&lt;/b&gt;；QGC 摇杆是本次唯一有效的手动输入。&lt;br&gt;QGC &lt;b&gt;RC_CHANNELS_OVERRIDE&lt;/b&gt; 会进入 &lt;b&gt;input_rc&lt;/b&gt; 并触发 &lt;b&gt;rc_update&lt;/b&gt;，但生成的 &lt;b&gt;manual_control_input&lt;/b&gt; 仍是 &lt;b&gt;SOURCE_RC&lt;/b&gt;，被 selector 拒绝。" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#37474F;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="843" width="745" height="110" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
  <diagram name="04 MAVLink/QGC 链路" id="p04">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p04-title" value="MAVLink / QGC 链路：消息级信息流" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=23;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="15" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p04-sub" value="QGC 与 ROS 2 是两条独立链路：QGC 负责监视/地面操作；本次圆周飞行的控制指令来自 ROS 2" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#B71C1C" vertex="1" parent="1">
          <mxGeometry x="300" y="55" width="1000" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p04-inband" value="① 入站：QGC → PX4（mavlink_receiver.cpp，UDP 18570）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=12;fontStyle=1;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="30" y="85" width="1480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p04-h0" value="QGC 发送" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="270" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p04-h1" value="UDP / 端口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="310" y="120" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p04-h2" value="MavlinkReceiver 入口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="480" y="120" width="310" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p04-h3" value="uORB / 模块" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="310" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p04-h4" value="结果" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="1120" y="120" width="390" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p04-i00" value="COMMAND_LONG / COMMAND_INT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FBFF;strokeColor=#90CAF9;fontSize=9.5;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=6" vertex="1" parent="1">
          <mxGeometry x="30" y="150" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p04-i01" value="MAVLink v2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FBFF;strokeColor=#90CAF9;fontSize=9.5;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=6" vertex="1" parent="1">
          <mxGeometry x="310" y="150" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p04-i02" value="handle_message_command_long / _int" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FBFF;strokeColor=#90CAF9;fontSize=9.5;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=6" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p04-i03" value="vehicle_command_s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FBFF;strokeColor=#90CAF9;fontSize=9.5;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=6" vertex="1" parent="1">
          <mxGeometry x="800" y="150" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p04-i04" value="commander::handle_command()；解锁/模式/ACK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FBFF;strokeColor=#90CAF9;fontSize=9.5;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=6" vertex="1" parent="1">
          <mxGeometry x="1120" y="150" width="390" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p04-i10" value="SET_MODE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FBFF;strokeColor=#90CAF9;fontSize=9.5;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=6" vertex="1" parent="1">
          <mxGeometry x="30" y="205" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p04-i11" value="MAVLink v2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FBFF;strokeColor=#90CAF9;fontSize=9.5;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=6" vertex="1" parent="1">
