        <mxCell id="p01-n3" value="rcS:240-293；airframe 4050_gz_netdrone:11-53&#10;注意 rc.mc_defaults 设置 VEHICLE_TYPE=mc" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#0D47A1;fillColor=#E3F2FD;strokeColor=#90CAF9;spacingLeft=6" vertex="1" parent="1">
