        </mxCell>
        <mxCell id="p02-rtcm2" value="rtcm_corrections&#10;uORB 300 B 分块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="580" y="820" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p02-rtcm3" value="GPS::handleInjectDataTopic&lt;br&gt;→ 串口写入真实 GNSS 接收机&lt;br&gt;（见上方 hw1）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#757575;dashed=1;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="820" y="820" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p02-note" value="关键参数：SIM_GPS_USED=10（默认，≥4 才有 3D fix）；EKF2_REQ_GPS_H=0.5（SITL 加速）；&#10;EKF2_GPS_CTRL 选择融合水平/垂直/速度/偏航；SENS_GPS_MASK 控制双接收机融合；SENS_GPS0_DELAY 校时。&#10;世界原点（default.sdf）：47.397971, 8.546164；首次 NavSat 只建立参考点，不发布 sensor_gps。" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#4E342E;fillColor=#EFEBE9;strokeColor=#A1887F;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="40" y="910" width="1530" height="75" as="geometry" />
