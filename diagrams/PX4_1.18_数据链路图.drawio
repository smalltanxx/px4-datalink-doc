  <diagram name="02 GPS 链路" id="p02">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p02-title" value="GPS / GNSS 链路：从 Gazebo NavSat 到 EKF2、QGC、ROS 2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=23;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="420" y="15" width="760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p02-sub" value="SITL 主链路：Gazebo NavSat → gz_bridge → sensor_gps → VehicleGPSPosition → vehicle_gps_position → EKF2" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="380" y="55" width="840" height="22" as="geometry" />
        </mxCell>

        <mxCell id="p02-hw1" value="真实 GNSS 接收机&lt;br&gt;UBX / NMEA / RTCM&lt;br&gt;（串口双向）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#757575;dashed=1;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p02-hw2" value="gps 驱动&#10;src/drivers/gps/gps.cpp&#10;协议识别 + RTCM 注入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#757575;dashed=1;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p02-hw3" value="sensor_gps&#10;（与 SITL 同一 uORB 接口）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;dashed=1;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="580" y="100" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p02-gz" value="Gazebo NavSat 传感器&#10;navsat_sensor，10 Hz&#10;纬度/经度/高度/速度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p02-bridge" value="GZBridge::navSatCallback&#10;首次 fix 初始化 _pos_ref&#10;加 ublox F9P 噪声模型&#10;填 sensor_gps_s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p02-sg" value="sensor_gps&#10;uORB 多实例&#10;≥4 颗星 → fix_type=3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="580" y="220" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p02-vgp" value="VehicleGPSPosition&#10;选主/备份、天线偏移&#10;时间延迟/PPS 校正&#10;发布 vehicle_gps_position" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="820" y="220" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p02-vgp2" value="vehicle_gps_position&#10;独立 uORB topic（SensorGps）&#10;VehicleGPSPosition 发布" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1100" y="220" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p02-ekf" value="EKF2::UpdateGpsSample&#10;setGpsData()&#10;GNSS 位置/速度/高度融合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1370" y="220" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p02-lpos" value="vehicle_local_position&#10;x/y/z、vx/vy/vz、xy_valid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1370" y="380" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p02-gpos" value="vehicle_global_position&#10;lat/lon/alt（融合后）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1100" y="380" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p02-mc" value="mc_pos_control&#10;OFFBOARD 位置控制输入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1370" y="500" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p02-mav" value="MAVLink 流&lt;br&gt;GPS_RAW_INT ← sensor_gps&lt;br&gt;GLOBAL_POSITION_INT ← EKF2&lt;br&gt;GPS2_RAW（第二接收机）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="760" y="380" width="290" height="80" as="geometry" />
