        <mxCell id="b1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="352" y="242" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1045" y="700" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1045" y="800" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1370" y="505" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="740" y="300" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="390" y="360" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lb" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;本实验链路清单（按进程边界）&lt;/b&gt;&lt;br&gt;① Gazebo ↔ PX4：gz-transport 双向（上行 传感器/clock/pose；下行 执行器/电机指令；⑥ 为执行器下行细节）&lt;br&gt;② PX4 ↔ QGC：MAVLink v2 over UDP 双向（上行 遥测/状态/ACK；下行 指令/参数/任务、mission）&lt;br&gt;③ PX4 ↔ Agent：XRCE-DDS over UDP 8888 双向（上行 uORB→DDS；下行 DDS→uORB）&lt;br&gt;④ Agent ↔ ROS 2：DDS/RTPS domain 0 双向（上行 /fmu/out；下行 /fmu/in）&lt;br&gt;⑤ PX4 内部：uORB 双向发布/订阅总线（所有 PX4 模块；mavlink、uxrce_dds_client 也接在此）&lt;br&gt;&lt;span style=&quot;color:#5A6670&quot;&gt;　　逻辑处理顺序：sensor_* → EKF2 → commander/control → actuator_motors&lt;/span&gt;&lt;br&gt;⑥ PX4 → Gazebo 电机：actuator_motors → gz.msgs.Actuators（/netdrone_0/command/motor_speed）&lt;br&gt;⑦ 真实硬件替换：RC→rc_input，GNSS→gps 驱动，PWM/DShot→pwm_out（不在本图，见第 11 章）" style="text;html=1;align=left;verticalAlign=top;fontSize=11.4;fontColor=#212121;fillColor=#FAFAFA;strokeColor=#BDBDBD;spacingLeft=9;spacingTop=6;whiteSpace=wrap" vertex="1" parent="1">
          <mxGeometry x="40" y="915" width="1500" height="185" as="geometry" />
        </mxCell>
      <mxCell id="gzserver" value="gz sim -r -s default.sdf（server）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#558B2F&quot;&gt;world = /world/default&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2E7D32;spacingLeft=2" vertex="1" parent="1"><mxGeometry x="65" y="118" width="250" height="40" as="geometry" /></mxCell><mxCell id="gzctx" value="&lt;b&gt;运行上下文（不是链路节点）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Physics/ODE：max_step_size = 0.004 s&lt;br&gt;gz sim -g：仅 GUI 观察，不参与数据链&lt;br&gt;模型：netdrone/model.sdf&lt;br&gt;世界原点：47.397971, 8.546164&lt;br&gt;&lt;i&gt;server 加载 world、推进物理并产生 clock/传感器数据；GUI 只显示。&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#9E9E9E;dashed=1;dashPattern=6 4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#455A64" vertex="1" parent="1"><mxGeometry x="60" y="550" width="260" height="205" as="geometry" /></mxCell><mxCell id="g1note" value="&lt;b style=&quot;color:#EF6C00&quot;&gt;① gz-transport 双向&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px&quot;&gt;上行 Gazebo→PX4：传感器 / clock / pose&lt;br&gt;下行 PX4→Gazebo：执行器 / 电机指令（见 ⑥）&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#455A64;spacingLeft=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="65" y="300" width="250" height="80" as="geometry" /></mxCell><mxCell id="gztx" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EF6C00;strokeColor=#EF6C00;" vertex="1" parent="1"><mxGeometry x="337" y="226" width="8" height="8" as="geometry" /></mxCell><mxCell id="e1s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2.2;strokeColor=#EF6C00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gz2" target="gztx"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;startSize=7;endArrow=block;endFill=1;endSize=7;strokeWidth=2;strokeColor=#EF6C00;exitX=1;exitY=0.82;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="orb" target="mav"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;startSize=7;endArrow=block;endFill=1;endSize=7;strokeWidth=2;strokeColor=#EF6C00;exitX=1;exitY=0.9533;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="orb" target="uxr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="uorbnote" value="&lt;b&gt;uORB 是双向发布/订阅总线&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.2px&quot;&gt;模块既可 publish 也可 subscribe。ROS 2 读 GPS 时，uxrce_dds_client 订阅 GPS 对应的 uORB 话题，再发布 /fmu/out；ROS 2 发 /fmu/in 时，uxrce_dds_client 写入对应 uORB，控制模块再订阅。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=9.8;fontColor=#0D47A1;fillColor=#E3F2FD;strokeColor=#90CAF9;spacingLeft=6;spacingTop=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="700" width="250" height="95" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
  <diagram name="01 启动时序" id="p01">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p01-title" value="`make px4_sitl gz_netdrone` 启动时序（代码级）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=23;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="430" y="15" width="740" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p01-time" value="时间" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="455" y="70" width="60" height="20" as="geometry" />
        </mxCell>

        <mxCell id="p01-s1" value="① make px4_sitl gz_netdrone&#10;CMake 配置目标 px4_sitl_default；gz_netdrone 是 add_custom_target&#10;环境：PX4_SIM_MODEL=gz_netdrone / GZ_IP=127.0.0.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="500" height="78" as="geometry" />
        </mxCell>
        <mxCell id="p01-s2" value="② 启动 build/px4_sitl_default/bin/px4&#10;工作目录 build/px4_sitl_default/rootfs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="540" y="185" width="500" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p01-s3" value="③ px4 执行 ROMFS/…/init.d-posix/rcS&#10;按 PX4_SIM_MODEL 找到 4050_gz_netdrone&#10;source rc.mc_defaults → VEHICLE_TYPE=mc, MAV_TYPE=2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="540" y="275" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p01-s4" value="④ rcS:243 source px4-rc.simulator&#10;SIM_GZ_EN=1 → source px4-rc.gzsim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="540" y="383" width="500" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p01-s5" value="⑤ 启动 Gazebo server 与 GUI&#10;gz sim --verbose=1 -r -s worlds/default.sdf&#10;gz sim -g（HEADLESS 为空时）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="540" y="473" width="500" height="78" as="geometry" />
        </mxCell>
        <mxCell id="p01-s6" value="⑥ gz service /world/default/create 生成 netdrone_0&#10;然后 gz_bridge start -w default -n netdrone_0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="540" y="580" width="500" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p01-s7" value="⑦ GZBridge::init()&#10;等 clock → 订阅 pose → 订阅 IMU/Mag/NavSat/Baro&#10;初始化 ESC/Servo/Wheel mixing 接口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="540" y="670" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p01-s8" value="⑧ rcS 继续启动：rc_update / manual_control / sensors&#10;commander / ekf2 / pwm_out_sim / navigator / 控制链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="540" y="780" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p01-s9" value="⑨ uxrce_dds_client start -t udp -p 8888&#10;source px4-rc.mavlink：mavlink start -u 18570" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="540" y="880" width="500" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p01-s10" value="⑩ 主机侧：QGC 连 18570；MicroXRCEAgent 监听 8888；ROS 2 节点启动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=11;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="540" y="972" width="500" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p01-n1" value="CMake：src/modules/simulation/gz_bridge/CMakeLists.txt:108-121&#10;Makefile：cmake-build 宏，ARGS 传给 cmake --build" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#0D47A1;fillColor=#E3F2FD;strokeColor=#90CAF9;spacingLeft=6" vertex="1" parent="1">
