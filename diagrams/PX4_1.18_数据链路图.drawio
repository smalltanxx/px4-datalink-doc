        <mxCell id="p01-n2" value="platforms/posix/CMakeLists.txt:157-158&#10;SITL_WORKING_DIR = build/px4_sitl_default/rootfs" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#0D47A1;fillColor=#E3F2FD;strokeColor=#90CAF9;spacingLeft=6" vertex="1" parent="1">
          <mxGeometry x="1080" y="190" width="440" height="50" as="geometry" />
